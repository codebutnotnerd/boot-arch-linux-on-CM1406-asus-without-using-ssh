#!/bin/bash
# ==============================================================================
# flash-internal.sh - Dual-boot Omarchy on ASUS Chromebook CM14 internal eMMC
# Target: ASUS Chromebook CM14 (CM1406CM4A - Dotation Île-de-France)
# Storage: 64 GB eMMC target (/dev/mmcblk0)
# ==============================================================================
# Installs Omarchy on ROOT-C (partition 7) and sets up signed mainline/custom
# kernel on KERN-B (partition 4) with automatic ChromeOS fallback.
# ==============================================================================
set -euo pipefail

DISK="${DISK:-/dev/mmcblk0}"
ALARM_ARCHIVE="${ALARM_ARCHIVE:-}"
REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
KERNEL_FIT="${KERNEL_FIT:-$REPO_ROOT/artifacts/kernel.fit}"
BACKUP_DIR=""

if [[ "$EUID" -ne 0 ]]; then
  echo "Error: run this script as root." >&2
  exit 1
fi
if [[ ! "$DISK" =~ ^/dev/mmcblk[0-9]+$ || ! -b "$DISK" ]]; then
  echo "Error: refusing non-eMMC target: $DISK" >&2
  exit 1
fi
if [[ -z "$ALARM_ARCHIVE" ]]; then
  ALARM_ARCHIVE="$REPO_ROOT/artifacts/ArchLinuxARM-aarch64-latest.tar.gz"
fi
if [[ ! -s "$KERNEL_FIT" ]]; then
  echo "Error: kernel FIT not found: $KERNEL_FIT" >&2
  exit 1
fi
if [[ ! -s "$ALARM_ARCHIVE" || ! -s "$ALARM_ARCHIVE.md5" ]]; then
  echo "Error: a local rootfs archive and its .md5 file are required." >&2
  echo "Set ALARM_ARCHIVE=/path/to/ArchLinuxARM-aarch64-latest.tar.gz." >&2
  exit 1
fi
for required_command in cgpt dd md5sum bsdtar mkfs.ext4 blkid findmnt; do
  if ! command -v "$required_command" >/dev/null 2>&1; then
    echo "Error: required command is missing: $required_command" >&2
    exit 1
  fi
done
expected_md5="$(awk 'NR == 1 { print $1 }' "$ALARM_ARCHIVE.md5" | tr '[:upper:]' '[:lower:]')"
[[ "$expected_md5" =~ ^[0-9a-f]{32}$ ]] || { echo "Error: invalid rootfs MD5 file." >&2; exit 1; }
actual_md5="$(md5sum "$ALARM_ARCHIVE" | awk '{ print $1 }' | tr '[:upper:]' '[:lower:]')"
[[ "$actual_md5" == "$expected_md5" ]] || { echo "Error: rootfs checksum mismatch; refusing internal installation." >&2; exit 1; }

part_dev() {
  local disk=$1 part=$2
  if [[ $disk =~ [0-9]$ ]]; then
    echo "${disk}p${part}"
  else
    echo "${disk}${part}"
  fi
}

KERN_B=$(part_dev "$DISK" 4)
ROOT_C=$(part_dev "$DISK" 7)

echo "=== ASUS Chromebook CM14 (CM1406CM4A) Internal Dual-Boot Setup ==="
echo "Target disk: $DISK"
echo "Kernel slot: $KERN_B (KERN-B)"
echo "Root slot:   $ROOT_C (ROOT-C)"

KERN_A=$(part_dev "$DISK" 2)
if [[ ! -b "$KERN_A" || ! -b "$KERN_B" || ! -b "$ROOT_C" ]]; then
  echo "Error: KERN-B or ROOT-C partition does not exist on $DISK!" >&2
  echo "Ensure the internal eMMC has been resized for dual boot (e.g. via chrx / cgpt)." >&2
  exit 1
fi
if findmnt -rn -S "$ROOT_C" >/dev/null 2>&1; then
  echo "Error: ROOT-C is mounted; unmount it before continuing." >&2
  exit 1
fi

echo "WARNING: this will format ROOT-C ($ROOT_C) and replace KERN-B ($KERN_B)."
echo "KERN-A ($KERN_A), ROOT-A (p3), and ROOT-B (p5) will not be written."
if [[ "${CONFIRM_INTERNAL_ERASE:-}" != "$DISK" ]]; then
  if [[ ! -t 0 ]]; then
    echo "Error: non-interactive run refused. Set CONFIRM_INTERNAL_ERASE='$DISK' to confirm." >&2
    exit 1
  fi
  read -r -p "Type '$DISK' to continue: " confirmation
  [[ "$confirmation" == "$DISK" ]] || { echo "Confirmation did not match; aborting." >&2; exit 1; }
fi

# Preserve both ChromeOS kernel slots and their priorities before any writes.
BACKUP_DIR="/root/backup/asus-cm14-$(date -u +%Y%m%dT%H%M%SZ)"
install -d -m 700 "$BACKUP_DIR"
for item in "kern-a:$KERN_A:2" "kern-b:$KERN_B:4"; do
  IFS=: read -r name partition index <<< "$item"
  dd if="$partition" of="$BACKUP_DIR/$name.bin" bs=1M status=progress conv=fsync
  cgpt show -i "$index" -P "$DISK" > "$BACKUP_DIR/priority-$index"
  cgpt show -i "$index" -T "$DISK" > "$BACKUP_DIR/tries-$index"
  cgpt show -i "$index" -S "$DISK" > "$BACKUP_DIR/successful-$index"
done
[[ -s "$BACKUP_DIR/kern-a.bin" && -s "$BACKUP_DIR/kern-b.bin" ]] || {
  echo "Error: kernel backups are incomplete; refusing to continue." >&2
  exit 1
}
echo "ChromeOS kernel backups saved in $BACKUP_DIR"

# Sign and validate the replacement before formatting ROOT-C.
SIGNED_KERNEL_DIR="$(mktemp -d /tmp/asus-cm14-kern.XXXXXX)"
SIGNED_KERNEL="$SIGNED_KERNEL_DIR/kernel.bin"
trap 'rm -rf "$SIGNED_KERNEL_DIR"' EXIT
bash "$REPO_ROOT/install/sign-kernel.sh" \
  --vmlinuz "$KERNEL_FIT" \
  --out "$SIGNED_KERNEL" \
  --target internal
if (( $(stat -c %s "$SIGNED_KERNEL") > 64 * 1024 * 1024 )); then
  echo "Error: signed kernel exceeds the 64 MiB ChromeOS kernel partition." >&2
  rm -f "$SIGNED_KERNEL"
  exit 1
fi

# Format ROOT-C as ext4
echo "== Formatting $ROOT_C as ext4 (ROOT-C)..."
mkfs.ext4 -F -L OMARCHY_ROOT "$ROOT_C"

MNT="/tmp/cm14_root_c"
mkdir -p "$MNT"
mount "$ROOT_C" "$MNT"
trap 'umount "$MNT" 2>/dev/null || true; rmdir "$MNT" 2>/dev/null || true; rm -rf "$SIGNED_KERNEL_DIR"' EXIT

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

echo "== Verifying rootfs checksum and extracting Arch Linux ARM..."
bsdtar -xpf "$ALARM_ARCHIVE" -C "$MNT"

# Copy port overlay
echo "== Applying ASUS CM14 port files..."
cp -a "$REPO_ROOT/port/quigon/root/." "$MNT/"

echo "asus-cm14" > "$MNT/etc/hostname"
root_partuuid="$(blkid -s PARTUUID -o value "$ROOT_C")"
[[ -n "$root_partuuid" ]] || { echo "Error: failed to read ROOT-C PARTUUID." >&2; exit 1; }
cat > "$MNT/etc/fstab" <<FSTAB
PARTUUID=$root_partuuid / ext4 defaults,noatime 0 1
FSTAB
for executable_dir in \
  usr/local/bin usr/local/sbin usr/local/libexec/quigon \
  usr/lib/systemd/system-sleep usr/lib/systemd/system-generators \
  usr/lib/NetworkManager/dispatcher.d; do
  [[ -d "$MNT/$executable_dir" ]] && find "$MNT/$executable_dir" -type f -exec chmod 755 {} +
done

SOC="${SOC:-mt8186}"
MODULES_ROOT="$REPO_ROOT/artifacts/modules-$SOC/lib/modules"
if [[ -d "$MODULES_ROOT" ]]; then
  mkdir -p "$MNT/usr/lib/modules"
  cp -a "$MODULES_ROOT/." "$MNT/usr/lib/modules/"
else
  echo "Warning: no built modules for $SOC at $MODULES_ROOT." >&2
fi
SYSTEMD_WANTS="$MNT/etc/systemd/system/multi-user.target.wants"
mkdir -p "$SYSTEMD_WANTS"
if [[ -f "$MNT/etc/systemd/system/asus-cm14-first-boot.service" ]]; then
  ln -sf /etc/systemd/system/asus-cm14-first-boot.service "$SYSTEMD_WANTS/asus-cm14-first-boot.service"
fi

echo "== Writing signed kernel to KERN-B..."
dd if="$SIGNED_KERNEL" of="$KERN_B" bs=1M conv=fsync status=progress
cgpt add -i 4 -P 15 -T 1 -S 1 "$DISK"
cgpt add -i 2 -P 1 "$DISK"

sync
echo "=========================================================="
echo "Internal installation complete. KERN-B now boots Omarchy; KERN-A remains unchanged."
echo "To restore both ChromeOS kernel partitions, run: sudo bash install/restore-chromeos.sh"
echo "Backup directory: $BACKUP_DIR"
echo "=========================================================="
