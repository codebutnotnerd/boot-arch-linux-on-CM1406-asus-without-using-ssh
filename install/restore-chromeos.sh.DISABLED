#!/usr/bin/env bash
set -euo pipefail

DISK="${DISK:-/dev/mmcblk0}"
BACKUP_DIR="${BACKUP_DIR:-}"

if [[ "$EUID" -ne 0 ]]; then
  echo "Error: run this script as root." >&2
  exit 1
fi
if [[ ! "$DISK" =~ ^/dev/mmcblk[0-9]+$ || ! -b "$DISK" ]]; then
  echo "Error: refusing non-eMMC target: $DISK" >&2
  exit 1
fi
for required_command in cgpt dd blockdev; do
  if ! command -v "$required_command" >/dev/null 2>&1; then
    echo "Error: required command is missing: $required_command" >&2
    exit 1
  fi
done

if [[ -z "$BACKUP_DIR" ]]; then
  BACKUP_DIR="$(find /root/backup -maxdepth 1 -type d -name 'asus-cm14-*' -print 2>/dev/null | sort | tail -n 1)"
fi
if [[ -z "$BACKUP_DIR" ]]; then
  echo "Error: no ASUS CM14 kernel backup directory found." >&2
  exit 1
fi

part_dev() {
  local disk=$1 part=$2
  printf '%s\n' "${disk}p${part}"
}

for index in 2 4; do
  for field in priority tries successful; do
    value_file="$BACKUP_DIR/$field-$index"
    if [[ ! -s "$value_file" ]] || ! grep -Eq '^[0-9]+$' "$value_file"; then
      echo "Error: missing or invalid backup metadata: $value_file" >&2
      exit 1
    fi
  done
  if [[ "$index" == 2 ]]; then
    kernel_backup="$BACKUP_DIR/kern-a.bin"
    partition="/dev/${DISK##*/}p2"
  else
    kernel_backup="$BACKUP_DIR/kern-b.bin"
    partition="/dev/${DISK##*/}p4"
  fi
  if [[ ! -s "$kernel_backup" ]]; then
    echo "Error: kernel backup is missing for partition $index." >&2
    exit 1
  fi
  if [[ ! -b "$partition" ]] || (( $(stat -c %s "$kernel_backup") != $(blockdev --getsize64 "$partition") )); then
    echo "Error: backup size does not match kernel partition $index." >&2
    exit 1
  fi
done

KERN_A="$(part_dev "$DISK" 2)"
KERN_B="$(part_dev "$DISK" 4)"
[[ -b "$KERN_A" && -b "$KERN_B" ]] || {
  echo "Error: expected ChromeOS kernel partitions were not found on $DISK." >&2
  exit 1
}

echo "WARNING: restoring ChromeOS kernel slots on $DISK from $BACKUP_DIR."
echo "ROOT-C is not changed. Confirm the internal disk before continuing."
if [[ "${CONFIRM_RESTORE:-}" != "$DISK" ]]; then
  if [[ ! -t 0 ]]; then
    echo "Error: non-interactive run refused. Set CONFIRM_RESTORE='$DISK' to confirm." >&2
    exit 1
  fi
  read -r -p "Type '$DISK' to continue: " confirmation
  [[ "$confirmation" == "$DISK" ]] || { echo "Confirmation did not match; aborting." >&2; exit 1; }
fi

dd if="$BACKUP_DIR/kern-a.bin" of="$KERN_A" bs=1M conv=fsync status=progress
dd if="$BACKUP_DIR/kern-b.bin" of="$KERN_B" bs=1M conv=fsync status=progress
for index in 2 4; do
  cgpt add -i "$index" \
    -P "$(cat "$BACKUP_DIR/priority-$index")" \
    -T "$(cat "$BACKUP_DIR/tries-$index")" \
    -S "$(cat "$BACKUP_DIR/successful-$index")" "$DISK"
done
sync
echo "ChromeOS KERN-A and KERN-B restored; original priorities and boot flags reapplied."
