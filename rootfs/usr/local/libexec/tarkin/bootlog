#!/bin/bash
exec > /var/log/tarkin-boot.log.tmp 2>&1
echo "== date";            date -u
echo "== uname";           uname -a
echo "== cmdline";         cat /proc/cmdline
echo "== systemd state";   systemctl is-system-running
echo "== failed units";    systemctl --failed --no-legend
echo "== console service"; systemctl status tarkin-console.service seatd.service --no-pager -n 30
echo "== console unit";    systemctl show tarkin-console.service -p ActiveState,SubState,Result,ExecMainStatus,NRestarts 2>/dev/null
echo "== console groups";  grep '^SupplementaryGroups=' /etc/systemd/system/tarkin-console.service 2>/dev/null; id alarm 2>&1; getent group video input render audio seat 2>&1
echo "== console journal"; journalctl -b -u tarkin-console.service -u seatd.service --no-pager 2>/dev/null | tail -80
echo "== drm";             ls -l /dev/dri 2>&1; for c in /sys/class/drm/card*; do echo "$c -> $(readlink -f "$c/device/driver" 2>/dev/null)"; done
echo "== input";           grep -E 'Name=|Handlers=' /proc/bus/input/devices
echo "== network";         ip -br addr
echo "== wlan0";           iw dev 2>/dev/null; wpa_cli -i wlan0 status 2>/dev/null
echo "== pci";             lspci -nn 2>/dev/null
echo "== modules";         lsmod
echo "== firmware errors"; dmesg | grep -i -E 'firmware|mt7925|mt79' | tail -40
echo "== journal (warnings, this boot)"; journalctl -b -p warning --no-pager 2>/dev/null | tail -150
echo "== dmesg";           dmesg | tail -300
mv -f /var/log/tarkin-boot.log.tmp /var/log/tarkin-boot.log
