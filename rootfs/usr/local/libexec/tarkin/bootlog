#!/bin/bash
# The Tarkin screen stays black under the stock ChromeOS kernel. This plain-text report lets you diagnose a
# failed first boot: plug the USB stick into ChromeOS, mount partition 2 and read <root>/var/log/tarkin-boot.log.
exec > /var/log/tarkin-boot.log.tmp 2>&1
echo "== date";            date -u
echo "== uname";           uname -a
echo "== cmdline";         cat /proc/cmdline
echo "== systemd state";   systemctl is-system-running
echo "== failed units";    systemctl --failed --no-legend
echo "== network";         ip -br addr
echo "== wlan0";           iw dev 2>/dev/null; wpa_cli -i wlan0 status 2>/dev/null
echo "== pci";             lspci -nn 2>/dev/null
echo "== modules";         lsmod
echo "== firmware errors"; dmesg | grep -i -E 'firmware|mt7925|mt79' | tail -40
echo "== journal (warnings, this boot)"; journalctl -b -p warning --no-pager 2>/dev/null | tail -150
echo "== dmesg";           dmesg | tail -300
mv -f /var/log/tarkin-boot.log.tmp /var/log/tarkin-boot.log
