#!/bin/bash
# Tarkin first boot (v1.50), started as root by tarkin-firstboot.service while
# /var/lib/tarkin/firstboot.pending exists (written by the USB installer).
#
# It waits for the network, then runs ~alarm/install-hyprland.sh AS THE USER alarm (runuser, never as root:
# that script refuses root) to install Hyprland, the Mali GPU stack and the PipeWire sound stack. That
# script calls sudo itself; for the duration of the run only, a temporary sudo rule lets alarm do so without
# a password (removed on exit, by ExecStopPost and by tmpfiles at the next boot). On success it disables
# itself and restarts the machine once into Hyprland. On failure the next boot tries again (3 boots at most).
# Log: /var/log/tarkin-firstboot.log
set -u
PENDING=/var/lib/tarkin/firstboot.pending
FAILED=/var/lib/tarkin/firstboot.failed
DONE=/var/lib/tarkin/firstboot.done
ATTEMPTS=/var/lib/tarkin/firstboot.attempts
LOG=/var/log/tarkin-firstboot.log
SUDOERS=/etc/sudoers.d/99-tarkin-firstboot
CONF=/etc/tarkin/firstboot.conf
USER_NAME=alarm
MAX_ATTEMPTS=3

# Optional settings: FIRSTBOOT_ARGS="--with-gdm" (extra install-hyprland.sh options), FIRSTBOOT_REBOOT=0.
FIRSTBOOT_ARGS=""
FIRSTBOOT_REBOOT=1
# shellcheck disable=SC1090
[[ -r "$CONF" ]] && . "$CONF"

touch "$LOG" && chmod 644 "$LOG"
exec > >(tee -a "$LOG") 2>&1

log() { echo "[$(date '+%F %T')] tarkin-firstboot: $*"; }
remove_sudo_rule() { rm -f "$SUDOERS" "$SUDOERS.tmp"; }
trap remove_sudo_rule EXIT

[[ -f "$PENDING" ]] || { log "nothing to do ($PENDING is absent)."; exit 0; }

uid="$(id -u "$USER_NAME" 2>/dev/null)" || { log "user $USER_NAME does not exist; giving up."; exit 1; }
home="$(getent passwd "$USER_NAME" | cut -d: -f6)"
script="$home/install-hyprland.sh"
[[ -f "$script" ]] || { log "$script is missing; nothing can be installed. Copy it from the repository."; exit 1; }

log "Hyprland + Mali GPU + sound for $USER_NAME: starting."

# 1. Network. Nothing can be installed without it, so wait as long as it takes.
waited=0
until getent hosts mirror.archlinuxarm.org >/dev/null 2>&1; do
  if (( waited % 120 == 0 )); then
    log "waiting for the network (mirror.archlinuxarm.org does not resolve yet)."
    log "  No Wi-Fi? In the terminal: sudo tarkin-wifi \"NetworkName\"  (the setup then starts by itself)."
  fi
  sleep 10
  waited=$((waited + 10))
done
log "network is up."
if [[ ! -f "$PENDING" ]]; then
  log "the setup was completed meanwhile (install-hyprland.sh run by hand); nothing to do."
  systemctl disable tarkin-firstboot.service >/dev/null 2>&1 || true
  exit 0
fi

# Only runs that got the network count as attempts (a boot without Wi-Fi must not use one up).
n="$(cat "$ATTEMPTS" 2>/dev/null || echo 0)"
[[ "$n" =~ ^[0-9]+$ ]] || n=0
n=$((n + 1))
echo "$n" > "$ATTEMPTS"
log "attempt $n of $MAX_ATTEMPTS."

# 2. The user manager of alarm (linger) provides /run/user/<uid> and the user D-Bus PipeWire needs.
for i in $(seq 1 120); do
  [[ -S "/run/user/$uid/bus" ]] && break
  if (( i == 30 )); then systemctl start "user@$uid.service" 2>/dev/null; fi
  sleep 1
done
[[ -S "/run/user/$uid/bus" ]] || log "warning: /run/user/$uid/bus is missing; the sound services may only be enabled at the next boot."

# 3. A stale pacman lock from an interrupted earlier attempt.
if [[ -e /var/lib/pacman/db.lck ]] && ! pgrep -x pacman >/dev/null 2>&1; then
  log "removing a stale pacman lock."
  rm -f /var/lib/pacman/db.lck
fi

# 4. Temporary sudo rule. verifypw=any lets "sudo -v" pass although the wheel rule asks for a password.
remove_sudo_rule
( umask 077
  printf 'Defaults:%s verifypw=any\n%s ALL=(ALL:ALL) NOPASSWD: ALL\n' "$USER_NAME" "$USER_NAME" > "$SUDOERS.tmp" )
chmod 440 "$SUDOERS.tmp"
if ! visudo -cf "$SUDOERS.tmp" >/dev/null 2>&1; then
  log "the temporary sudo rule does not parse; giving up."
  exit 1
fi
mv -f "$SUDOERS.tmp" "$SUDOERS"

# 5. The install itself, as alarm, with a clean login-like environment.
read -r -a extra <<< "$FIRSTBOOT_ARGS"
log "running: $script ${extra[*]:-} (as $USER_NAME)"
cd "$home" || exit 1
rc=0
runuser -u "$USER_NAME" -- env -i \
  HOME="$home" USER="$USER_NAME" LOGNAME="$USER_NAME" SHELL=/bin/bash LANG=C.UTF-8 TERM=dumb \
  PATH=/usr/local/sbin:/usr/local/bin:/usr/bin \
  XDG_RUNTIME_DIR="/run/user/$uid" DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid/bus" \
  TARKIN_FIRSTBOOT=1 \
  bash "$script" ${extra[@]+"${extra[@]}"} </dev/null || rc=$?
remove_sudo_rule

if (( rc == 0 )); then
  rm -f "$PENDING" "$FAILED" "$ATTEMPTS"
  date -u +%FT%TZ > "$DONE"
  systemctl disable tarkin-firstboot.service >/dev/null 2>&1 \
    || rm -f /etc/systemd/system/multi-user.target.wants/tarkin-firstboot.service
  log "done: Hyprland, the Mali GPU stack and sound are installed."
  sync
  if [[ "$FIRSTBOOT_REBOOT" == 1 ]]; then
    log "restarting in 20 seconds to start Hyprland on a clean system."
    sleep 20
    systemctl reboot
  else
    systemctl --no-block restart tarkin-console.service
  fi
  exit 0
fi

echo "rc=$rc attempt=$n date=$(date -u +%FT%TZ)" > "$FAILED"
log "FAILED (exit code $rc). The lines above say why."
if (( n >= MAX_ATTEMPTS )); then
  rm -f "$PENDING"
  systemctl disable tarkin-firstboot.service >/dev/null 2>&1 || true
  log "$MAX_ATTEMPTS attempts failed: automatic retries stop here. Fix the cause, then run by hand,"
  log "  in the terminal as alarm (not with sudo):  bash ~/install-hyprland.sh"
else
  log "It is tried again at the next boot. To retry now:  sudo systemctl restart tarkin-firstboot"
  log "  or by hand, in the terminal as alarm (not with sudo):  bash ~/install-hyprland.sh"
fi
exit 1
