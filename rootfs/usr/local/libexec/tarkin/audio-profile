#!/bin/bash
card=alsa_card.platform-soc_sound
sink=alsa_output.platform-soc_sound.pro-output-0
for _ in $(seq 1 30); do
  pactl set-card-profile "$card" pro-audio 2>/dev/null && break
  sleep 1
done
alsaucm -c mt8189_rt5650 set _verb HiFi set _enadev Speaker
amixer -q -c 0 cset "name='Speaker Playback Volume'" 22,22
for _ in $(seq 1 15); do
  pactl set-default-sink "$sink" 2>/dev/null && break
  sleep 1
done
wpctl set-volume @DEFAULT_AUDIO_SINK@ 1.0
