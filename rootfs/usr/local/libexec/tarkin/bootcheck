#!/bin/bash
# Boot check (v1.50), run as root by tarkin-bootcheck.service. Only reads; writes warnings to the journal
# and to /run/tarkin/boot-warnings (shown in new terminals). It never changes the partition table.
#
# The firmware substitutes %U in the kernel command line (root=PARTUUID=%U/PARTNROFF=1) with the unique
# GUID of the kernel partition it booted, so /proc/cmdline names the stick's kernel partition. Its GPT
# attribute bits (ChromeOS layout: priority 48-51, tries 52-55, successful 56) decide whether the firmware
# keeps booting it: with successful=0 every boot uses up one "try", and at 0 tries the stick stops booting.
set -u
out=/run/tarkin/boot-warnings
mkdir -p /run/tarkin
: > "$out"
chmod 644 "$out"
warn() { echo "$*" >> "$out"; echo "WARNING: $*"; }

kver="$(uname -r)"
if [[ ! -d "/usr/lib/modules/$kver" ]]; then
  warn "no kernel modules for the running kernel $kver in /usr/lib/modules (Wi-Fi and sound need them). The kernel on the stick does not match its modules: make the stick again from ChromeOS (sudo bash install.sh)."
fi

kuuid="$(sed -n 's/.*root=PARTUUID=\([0-9A-Fa-f-]\{36\}\)\/PARTNROFF=1.*/\1/p' /proc/cmdline | tr '[:upper:]' '[:lower:]')"
if [[ -z "$kuuid" ]]; then
  echo "kernel partition: not named in /proc/cmdline; nothing to check."
  exit 0
fi
kdev="$(readlink -f "/dev/disk/by-partuuid/$kuuid" 2>/dev/null || true)"
if [[ -z "$kdev" || ! -b "$kdev" ]]; then
  kdev="$(blkid -t "PARTUUID=$kuuid" -o device 2>/dev/null | head -n 1)"
fi
if [[ -z "$kdev" || ! -b "$kdev" ]]; then
  echo "kernel partition $kuuid: device node not found; nothing to check."
  exit 0
fi
info="$(blkid -p -o export "$kdev" 2>/dev/null || true)"
scheme="$(sed -n 's/^PART_ENTRY_SCHEME=//p' <<<"$info")"
flags="$(sed -n 's/^PART_ENTRY_FLAGS=//p' <<<"$info")"
if [[ "$scheme" != gpt ]]; then
  echo "kernel partition $kdev: GPT attributes not readable (scheme '${scheme:-none}'); nothing to check."
  exit 0
fi
# The system booted from this partition, so all-zero attributes cannot be what the firmware saw; a missing
# value only means blkid did not report it. Never warn on a guess.
if [[ ! "$flags" =~ ^0x[0-9a-fA-F]+$ ]]; then
  echo "kernel partition $kdev: blkid reports no GPT attributes; nothing to check."
  exit 0
fi
prio=$(( (flags >> 48) & 15 ))
tries=$(( (flags >> 52) & 15 ))
succ=$(( (flags >> 56) & 1 ))
echo "kernel partition $kdev: priority=$prio tries=$tries successful=$succ (attributes $flags)"
if (( prio == 0 )); then
  warn "kernel partition $kdev has priority 0: the firmware will skip it. In ChromeOS: sudo bash scripts/repair-boot.sh"
elif (( succ == 0 )); then
  warn "kernel partition $kdev is not marked successful (tries left: $tries): it can stop booting. In ChromeOS: sudo bash scripts/repair-boot.sh"
fi
exit 0
