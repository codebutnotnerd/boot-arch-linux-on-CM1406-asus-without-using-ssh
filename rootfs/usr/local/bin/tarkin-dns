#!/bin/bash
set -u
[[ $EUID -eq 0 ]] || { echo "Run it with sudo: sudo tarkin-dns" >&2; exit 1; }
KEEP=0
IFACE=wlan0
for a in "$@"; do
  case "$a" in
    --keep) KEEP=1 ;;
    *) IFACE="$a" ;;
  esac
done
PRIMARY="1.1.1.1 1.0.0.1"
FALLBACK="9.9.9.9 149.112.112.112"
TEST_HOST="archlinuxarm.org"

[[ -d "/sys/class/net/$IFACE" ]] || { echo "[-] Interface $IFACE not found (pass its name: sudo tarkin-dns wlan1)." >&2; exit 1; }
command -v resolvectl >/dev/null || { echo "[-] resolvectl is missing: systemd-resolved is not installed." >&2; exit 1; }
systemctl is-active --quiet systemd-resolved || { echo "[-] systemd-resolved is not running: sudo systemctl enable --now systemd-resolved" >&2; exit 1; }

echo "== Checking the connection (by address, no DNS)"
if ! ping -c 2 -W 3 1.1.1.1 >/dev/null 2>&1 && ! ping -c 2 -W 3 9.9.9.9 >/dev/null 2>&1; then
  echo "[-] No internet even by IP address: this is not a DNS problem. Check the Wi-Fi: sudo tarkin-wifi \"NetworkName\"" >&2
  exit 1
fi

echo "== Current DNS on $IFACE"
resolvectl dns "$IFACE" 2>&1

echo "== Setting $PRIMARY (fallback $FALLBACK) on $IFACE until the next reboot"
resolvectl dns "$IFACE" $PRIMARY $FALLBACK
resolvectl domain "$IFACE" "~."
resolvectl flush-caches

if getent ahosts "$TEST_HOST" >/dev/null 2>&1; then
  echo "[+] Names resolve: $TEST_HOST -> $(getent ahosts "$TEST_HOST" | awk 'NR==1 {print $1}')"
else
  echo "[-] Names still do not resolve. Try again in a few seconds, or send: sudo tarkin-diag" >&2
  exit 1
fi

if (( KEEP )); then
  mkdir -p /etc/systemd/resolved.conf.d /etc/systemd/network/wlan.network.d
  printf '[Resolve]\nDNS=%s\nFallbackDNS=%s\nDomains=~.\n' "$PRIMARY" "$FALLBACK" > /etc/systemd/resolved.conf.d/10-tarkin-dns.conf
  printf '[DHCPv4]\nUseDNS=no\n\n[DHCPv6]\nUseDNS=no\n\n[IPv6AcceptRA]\nUseDNS=no\n' > /etc/systemd/network/wlan.network.d/10-tarkin-dns.conf
  systemctl restart systemd-resolved systemd-networkd
  echo "[+] Saved: the router's DNS servers are ignored from now on. Undo: sudo rm -r /etc/systemd/resolved.conf.d/10-tarkin-dns.conf /etc/systemd/network/wlan.network.d"
else
  echo "This setting is lost at reboot or when Wi-Fi reconnects. To keep it: sudo tarkin-dns --keep"
fi
