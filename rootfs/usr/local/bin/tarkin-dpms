#!/usr/bin/env python3
import fcntl
import os
from pathlib import Path
import re
import subprocess
import sys


def main():
    if len(sys.argv) != 2 or sys.argv[1] not in ("on", "off"):
        raise RuntimeError("Usage: tarkin-dpms on|off (inside Hyprland)")
    action = sys.argv[1]
    if action == "off":
        runtime = os.environ.get("XDG_RUNTIME_DIR")
        if not runtime:
            raise RuntimeError("XDG_RUNTIME_DIR is missing; run inside Hyprland.")
        try:
            pid = int((Path(runtime) / "tarkin-lock.ready").read_text())
            if pid <= 1:
                raise ValueError("invalid lock pid")
            os.kill(pid, 0)
            with (Path(runtime) / "tarkin-lock.flock").open("r") as guard:
                try:
                    fcntl.flock(guard, fcntl.LOCK_EX | fcntl.LOCK_NB)
                except BlockingIOError:
                    pass
                else:
                    raise ValueError("no active lock")
        except (OSError, ValueError):
            raise RuntimeError("Screen not confirmed locked by tarkin-lock; refusing DPMS off. Run tarkin-lock and check swaylock/PAM.")
    version = subprocess.run(["hyprctl", "version"], text=True, capture_output=True)
    if version.returncode:
        raise RuntimeError("hyprctl version failed; run inside the active Hyprland session: " + version.stderr.strip())
    match = re.search(r"Hyprland\s+v?(\d+)\.(\d+)", version.stdout)
    if not match:
        raise RuntimeError("Cannot identify Hyprland version; screen unchanged. Run hyprctl version and check the installed package.")
    modern = tuple(map(int, match.groups())) >= (0, 57)
    command = ["hyprctl", "dispatch"]
    command += [f'hl.dsp.dpms({{ action = "{action}" }})'] if modern else ["dpms", action]
    result = subprocess.run(command, text=True, capture_output=True)
    if result.returncode or result.stdout.strip() != "ok":
        raise RuntimeError("DPMS failed; screen state not confirmed: " + (result.stderr or result.stdout).strip())
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (OSError, RuntimeError) as exc:
        print(f"tarkin-dpms: {exc}", file=sys.stderr)
        sys.exit(1)
