#!/bin/bash
set -u
ok()   { echo "  [ok]   $*"; }
no()   { echo "  [no]   $*"; }
info() { echo "  [..]   $*"; }

GPU_ROOT="${TARKIN_GPU_ROOT:-/usr/local/lib/tarkin-gpu}"
MALI="$GPU_ROOT/mali/lib"
BIN="$GPU_ROOT/bin"
SHIM="$GPU_ROOT/lib/egl-mali-shim.so"
WRAPPER="${TARKIN_GPU_WRAPPER:-/usr/local/bin/hyprland-mali}"
SESSION="${TARKIN_GPU_SESSION:-/usr/share/wayland-sessions/hyprland-mali.desktop}"

echo "== GPU nodes"
ls -l /dev/dri 2>&1 | sed 's/^/   /'
if [[ -e /dev/mali0 ]]; then ok "/dev/mali0 exists"; else no "/dev/mali0 is missing (this kernel build has no Mali KBase support)"; fi
[[ -e /dev/dri/renderD128 ]] && ok "/dev/dri/renderD128 exists" || no "/dev/dri/renderD128 is missing"
id -nG | tr ' ' '\n' | grep -qx -E 'render|video' && ok "this user is in render or video" || no "this user is in neither render nor video (the console service adds them itself)"

echo "== kernel driver and DRM cards"
for c in /sys/class/drm/card[0-9]; do
  [[ -e "$c" ]] && echo "   $(basename "$c") -> $(basename "$(readlink -f "$c/device/driver" 2>/dev/null)")"
done
if compgen -G '/sys/module/*mali*' >/dev/null; then ok "Mali kernel module present: $(basename "$(ls -d /sys/module/*mali* | head -1)")"; else no "no Mali kernel module"; fi
if compgen -G '/sys/module/panfrost' >/dev/null; then ok "panfrost is loaded"; else info "panfrost is not available (expected on this kernel)"; fi

echo "== installed GPU stack ($GPU_ROOT)"
if [[ -d "$GPU_ROOT" ]]; then
  for f in "$MALI/libmali.so.0.54.1" "$MALI/libmali.so.0" "$MALI/libEGL.so.1" "$MALI/libGLESv2.so.2" "$SHIM" "$BIN/mali-probe" "$BIN/shim-probe" "$WRAPPER" "$SESSION"; do
    [[ -e "$f" ]] && ok "$f" || no "$f is missing"
  done
  if command -v readelf >/dev/null 2>&1 && [[ -e "$MALI/libmali.so.0.54.1" ]]; then
    if readelf -V "$MALI/libmali.so.0.54.1" 2>/dev/null | grep -q GLIBC_ABI_DT_RELR; then
      ok "libmali carries GLIBC_ABI_DT_RELR (works with Arch glibc)"
    else
      no "libmali misses GLIBC_ABI_DT_RELR; re-run: bash ~/install-hyprland.sh --gpu-only"
    fi
  else
    info "readelf is missing (binutils): cannot check GLIBC_ABI_DT_RELR"
  fi
else
  info "the GPU stack is not installed"
  info "install it with: bash ~/install-hyprland.sh   (or --gpu-only for the GPU files alone)"
fi

echo "== software rendering fallback (mesa)"
dri_dirs=(/usr/lib/dri /usr/lib/aarch64-linux-gnu/dri)
for f in kms_swrast_dri.so swrast_dri.so; do
  found=0
  for d in "${dri_dirs[@]}"; do [[ -e "$d/$f" ]] && { ok "$d/$f"; found=1; break; }; done
  (( found )) || no "$f is not installed"
done
command -v Hyprland >/dev/null && ok "Hyprland installed" || no "Hyprland is not installed"

echo "== GPU renderer probe (libmali, DMA-BUF into a DRM dumb buffer)"
if [[ -x "$BIN/mali-probe" ]]; then
  if out="$(env LD_LIBRARY_PATH="$MALI" timeout 30 "$BIN/mali-probe" 5 2>&1)"; then
    ok "Mali GLES + DMA-BUF render works"
    grep -E 'GL_RENDERER|dmabuf render' <<<"$out" | sed 's/^/        /'
  else
    no "the Mali probe failed:"; sed 's/^/        /' <<<"$out" | tail -5
  fi
else
  info "mali-probe is not installed (it comes with ~/install-hyprland.sh)"
fi
if [[ -x "$BIN/shim-probe" ]]; then
  if out2="$(env LD_LIBRARY_PATH="$MALI" LD_PRELOAD="$SHIM" timeout 30 "$BIN/shim-probe" 2>&1)"; then
    ok "the EGL device shim works (what Hyprland and Aquamarine need)"
    grep -E 'DRM primary|DRM render|SHIM TEST' <<<"$out2" | sed 's/^/        /'
  else
    no "the shim probe failed:"; sed 's/^/        /' <<<"$out2" | tail -5
  fi
else
  info "shim-probe is not installed"
fi

echo "== launcher"
if [[ -x "$WRAPPER" ]]; then
  if out3="$(timeout 30 "$WRAPPER" -- --version 2>&1)"; then
    ok "$WRAPPER reaches Hyprland"
    grep -m1 -E '^Hyprland' <<<"$out3" | sed 's/^/        /'
  else
    no "$WRAPPER -- --version failed:"; sed 's/^/        /' <<<"$out3" | tail -3
  fi
else
  info "$WRAPPER is not installed"
fi

echo "== session and display manager"
if [[ -e "$SESSION" ]]; then
  ok "$SESSION exists"
else
  info "$SESSION is not installed (only the GPU session needs it)"
fi
if command -v systemctl >/dev/null 2>&1; then
  if systemctl is-enabled gdm.service >/dev/null 2>&1; then
    ok "gdm.service is enabled: pick \"Hyprland (Mali GPU)\" with the gear in GDM"
  else
    info "gdm.service is not enabled: the tarkin-console handles the display and tries $WRAPPER first"
  fi
fi

cat <<'TXT'

== Reading the result
 - GL_RENDERER=Mali-G57 in the probe: hardware rendering works end to end.
 - The desktop session "Hyprland (Mali GPU)" uses this exact stack. The tarkin-console
   also tries /usr/local/bin/hyprland-mali first when TARKIN_HYPR_RENDER=auto (the default),
   then falls back to default Hyprland, then software, then the terminal.
 - If the probes pass but Hyprland still does not render on the GPU: sudo tarkin-diag,
   and QUIGON_EGL_SHIM_TRACE=1 /usr/local/bin/hyprland-mali for the EGL shim trace.
 - Without the GPU stack Hyprland runs on software rendering: it works, just slower.
 - Override the install location for tests with: TARKIN_GPU_ROOT=/path tarkin-gpu-check
TXT
