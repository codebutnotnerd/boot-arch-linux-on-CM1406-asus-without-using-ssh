#!/usr/bin/python3
import configparser
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tempfile


class SetupError(Exception):
    pass


def run(args, **kwargs):
    return subprocess.run(args, check=True, **kwargs)


def version_at(directory):
    try:
        value = json.loads((directory / 'manifest.json').read_text())['version']
        if not isinstance(value, str) or not re.fullmatch(r'\d+(?:\.\d+){1,7}', value):
            raise ValueError('invalid numeric version')
        if not (directory / 'libwidevinecdm.so').is_file():
            raise ValueError('libwidevinecdm.so missing')
        parts = tuple(int(v) for v in value.split('.'))
        return value, parts + (0,) * (8 - len(parts))
    except (OSError, ValueError, KeyError, TypeError) as exc:
        raise SetupError(f'Invalid Widevine directory {directory}: {exc}') from exc


def installed_source():
    listing = run(['/usr/bin/pacman', '-Ql', 'widevine'], text=True, stdout=subprocess.PIPE).stdout
    candidates = []
    for line in listing.splitlines():
        fields = line.split(maxsplit=1)
        if len(fields) == 2 and fields[1].endswith('/manifest.json'):
            directory = Path(fields[1]).parent
            if 'firefox' in directory.parts or 'gmp-widevinecdm' in directory.parts:
                candidates.append(directory)
    valid = []
    for candidate in candidates:
        try:
            version, key = version_at(candidate)
            valid.append((key, str(candidate), version))
        except SetupError:
            pass
    if not valid:
        raise SetupError('The installed widevine package has no valid Firefox manifest/library pair. Install or repair a reviewed AUR widevine package, then rerun.')
    _, path, version = max(valid)
    return Path(path), version


def configure_environment(source, target=Path('/etc/environment')):
    if target.is_symlink():
        raise SetupError(f'{target} is a symlink; configure MOZ_GMP_PATH manually instead.')
    old = target.read_text() if target.exists() else ''
    lines = [line for line in old.splitlines() if not re.match(r'^\s*(?:export\s+)?MOZ_GMP_PATH\s*=', line)]
    lines.append(f'MOZ_GMP_PATH="{source}"')
    fd, name = tempfile.mkstemp(prefix='.tarkin-environment-', dir=target.parent)
    try:
        with os.fdopen(fd, 'w') as out:
            out.write('\n'.join(lines) + '\n')
        os.chmod(name, target.stat().st_mode & 0o777 if target.exists() else 0o644)
        os.replace(name, target)
    finally:
        if os.path.exists(name):
            os.unlink(name)


def profiles(home):
    result = set()
    for base in (home / '.mozilla/firefox', home / '.config/mozilla/firefox'):
        for name in ('profiles.ini', 'installs.ini'):
            ini = base / name
            if not ini.is_file():
                continue
            cfg = configparser.ConfigParser(interpolation=None)
            cfg.read(ini)
            for section in cfg.sections():
                row = cfg[section]
                if section.startswith('Profile') and row.get('path'):
                    raw = Path(row['path'])
                    path = base / raw if row.get('isrelative', '1') == '1' else raw
                elif row.get('default') and row['default'] not in ('0', '1'):
                    raw = Path(row['default'])
                    path = raw if raw.is_absolute() else base / raw
                else:
                    continue
                path = path.resolve()
                if not path.is_dir():
                    raise SetupError(f'Configured Firefox profile is missing: {path}. Start Firefox once or repair {ini}, then rerun.')
                if path.stat().st_uid != os.getuid():
                    raise SetupError(f'Profile not owned by the current user: {path}. Run without sudo as the Firefox user.')
                result.add(path)
    return sorted(result)


def copy_profile(profile, source):
    version, key = version_at(source)
    root = profile / 'gmp-widevinecdm'
    if root.is_dir():
        for existing in root.iterdir():
            if not existing.is_dir():
                continue
            try:
                _, existing_key = version_at(existing)
            except SetupError:
                continue
            if existing_key >= key:
                print(f'Kept valid same/newer Widevine: {existing}')
                return
    root.mkdir(exist_ok=True)
    target = root / version
    if target.exists() or target.is_symlink():
        raise SetupError(f'Incomplete target already exists: {target}. Close Firefox, move it aside and rerun; no files were replaced.')
    with tempfile.TemporaryDirectory(prefix='.tarkin-widevine-', dir=root) as staging:
        staged = Path(staging) / version
        shutil.copytree(source, staged, symlinks=False)
        version_at(staged)
        os.rename(staged, target)
    print(f'Installed Widevine {version} in {profile}')


def build(checkout, revision):
    if not re.fullmatch(r'[0-9a-f]{40}', revision):
        raise SetupError('Supply the full 40-character AUR commit SHA you reviewed, not a branch or tag.')
    checkout = Path(checkout).resolve()
    actual = run(['/usr/bin/git', '-C', str(checkout), 'rev-parse', 'HEAD'], text=True, stdout=subprocess.PIPE).stdout.strip()
    dirty = run(['/usr/bin/git', '-C', str(checkout), 'status', '--porcelain', '--untracked-files=all'], text=True, stdout=subprocess.PIPE).stdout.strip()
    if actual != revision or dirty or not (checkout / 'PKGBUILD').is_file():
        raise SetupError('AUR checkout must be clean at the exact reviewed SHA, with PKGBUILD present. Use a fresh checkout and review all tracked files.')
    run(['/usr/bin/sudo', '/usr/local/bin/tarkin-update'])
    run(['/usr/bin/sudo', '/usr/bin/pacman', '-S', '--needed', 'base-devel', 'git', 'python', 'squashfs-tools', 'firefox'])
    run(['/usr/bin/makepkg', '--verifysource'], cwd=checkout)
    run(['/usr/bin/makepkg', '-si'], cwd=checkout)


def main():
    args = sys.argv[1:]
    if args == ['--system-environment']:
        if os.geteuid() != 0:
            raise SetupError('The environment helper requires authenticated sudo.')
        source, _ = installed_source()
        configure_environment(source)
        print('MOZ_GMP_PATH configured for login sessions (SDDM/GDM). Reboot before testing.')
        return
    if os.geteuid() == 0:
        raise SetupError('Run tarkin-firefox-widevine as your Firefox user, without sudo. AUR builds must never run as root.')
    if args:
        if len(args) != 3 or args[0] != '--build':
            raise SetupError('Usage: tarkin-firefox-widevine [--build /path/to/reviewed/aur-widevine FULL_COMMIT_SHA]')
        build(args[1], args[2])
    source, version = installed_source()
    found = profiles(Path.home())
    if not found:
        raise SetupError('No Firefox profiles found. Start Firefox once, close it, then rerun tarkin-firefox-widevine without sudo.')
    for profile in found:
        copy_profile(profile, source)
    run(['/usr/bin/sudo', '/usr/local/bin/tarkin-firefox-widevine', '--system-environment'])
    print(f'Widevine {version} configured. Reboot, enable DRM in Firefox settings, then test playback. Rerun for every new Firefox profile; Netflix is not validated.')


if __name__ == '__main__':
    try:
        main()
    except subprocess.CalledProcessError as exc:
        print(f'Command failed (exit {exc.returncode}): {exc.cmd}. Fix the error above, then rerun.', file=sys.stderr)
        sys.exit(exc.returncode if exc.returncode > 0 else 1)
    except (SetupError, OSError, configparser.Error) as exc:
        print(f'Widevine setup failed: {exc}', file=sys.stderr)
        sys.exit(1)
