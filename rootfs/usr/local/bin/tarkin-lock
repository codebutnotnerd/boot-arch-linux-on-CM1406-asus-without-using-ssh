#!/usr/bin/env python3
import fcntl
import os
from pathlib import Path
import select
import shutil
import subprocess
import sys


def main():
    runtime = os.environ.get("XDG_RUNTIME_DIR")
    if not runtime or not os.environ.get("WAYLAND_DISPLAY"):
        raise RuntimeError("Run inside the Hyprland session (WAYLAND_DISPLAY and XDG_RUNTIME_DIR are required).")
    if not shutil.which("swaylock"):
        raise RuntimeError("Install swaylock: sudo pacman -S --needed swaylock")
    directory = Path(runtime)
    if directory.stat().st_uid != os.getuid():
        raise RuntimeError("XDG_RUNTIME_DIR is not owned by this user; repair the session environment.")
    with (directory / "tarkin-lock.flock").open("w") as guard:
        try:
            fcntl.flock(guard, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return 0
        read_fd, write_fd = os.pipe()
        child = None
        marker = directory / "tarkin-lock.ready"
        marker.unlink(missing_ok=True)
        try:
            child = subprocess.Popen(["swaylock", "--ready-fd", str(write_fd)], pass_fds=(write_fd,))
            os.close(write_fd)
            write_fd = -1
            readable, _, _ = select.select([read_fd], [], [], 15)
            if not readable or not os.read(read_fd, 1):
                raise RuntimeError("swaylock did not confirm the lock; screen stays on. Check its stderr and /etc/pam.d/swaylock.")
            marker.write_text(str(os.getpid()))
            rc = child.wait()
            if rc:
                raise RuntimeError(f"swaylock exited with status {rc}; check /etc/pam.d/swaylock and the user password.")
            return 0
        finally:
            marker.unlink(missing_ok=True)
            os.close(read_fd)
            if write_fd >= 0:
                os.close(write_fd)
            if child is not None and child.poll() is None:
                child.terminate()
                child.wait()


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (OSError, RuntimeError) as exc:
        print(f"tarkin-lock: {exc}", file=sys.stderr)
        sys.exit(1)
