#!/bin/bash
set -euo pipefail
case "${1:-}" in desktop|terminal) ;; *) echo "Usage: sudo tarkin-session desktop|terminal" >&2; exit 1 ;; esac
[[ $EUID -eq 0 ]] || { echo "Run it with sudo." >&2; exit 1; }
mode="$(cat /etc/tarkin/console-mode 2>/dev/null || echo graphical)"
if [[ "$mode" == dm ]]; then
  cat >&2 <<EOF
This install hands the console to a display manager:
  $(readlink -f /etc/systemd/system/display-manager.service 2>/dev/null || echo 'display-manager.service')

tarkin-session only switches the tarkin-console session (desktop/terminal), and
tarkin-console is just the fallback when no display manager runs. Pick the
session in the greeter instead (Xfce / i3), or go back to the plain console:
  sudo systemctl disable --now display-manager
  sudo systemctl enable --now tarkin-console
  echo graphical | sudo tee /etc/tarkin/console-mode
EOF
  exit 1
fi
f=/etc/tarkin/console.env
mkdir -p /etc/tarkin
touch "$f"
if grep -q '^TARKIN_SESSION=' "$f"; then
  sed -i "s/^TARKIN_SESSION=.*/TARKIN_SESSION=$1/" "$f"
else
  echo "TARKIN_SESSION=$1" >> "$f"
fi
echo "Session set to: $1. Restarting the display now (this window will close)..."
systemctl --no-block restart tarkin-console.service
