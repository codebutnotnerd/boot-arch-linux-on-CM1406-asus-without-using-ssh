#!/bin/bash
set -euo pipefail
[[ $# == 0 ]] || { echo 'Usage: sudo tarkin-update (no options)' >&2; exit 2; }
[[ $EUID == 0 ]] || { echo 'Run: sudo tarkin-update' >&2; exit 1; }
command -v pacman >/dev/null || { echo 'pacman is missing; run this command inside the installed Arch system.' >&2; exit 1; }
if ! files=$(pacman -Ql); then
  echo 'Cannot inspect installed kernel files. Repair the local pacman database before updating.' >&2
  exit 1
fi
mapfile -t owners < <(awk '$2 ~ /^\/(usr\/)?lib\/modules\// || $2 ~ /^\/usr\/src\// || $2 ~ /^\/boot\/(vmlinuz|Image|zImage|dtbs|initramfs)/ {print $1}' <<< "$files" | sort -u)
ignore='linux,linux-*,linux-aarch64,linux-aarch64-headers'
for pkg in "${owners[@]}"; do
  [[ $pkg =~ ^[[:alnum:]@_+][[:alnum:]@._+-]*$ ]] || { echo "Invalid package name in local database: $pkg; repair pacman first." >&2; exit 1; }
  ignore+=",$pkg"
done
printf 'Preserving CM1406 kernel/modules/headers: %s\n' "$ignore"
echo 'Review the transaction. Do not approve removal or replacement of the preserved kernel packages.'
if pacman -Syu --ignore "$ignore"; then
  echo 'System update completed (pacman exit 0).'
else
  status=$?
  printf 'System update failed (pacman exit %s). Resolve the error above, then rerun sudo tarkin-update.\n' "$status" >&2
  exit "$status"
fi
