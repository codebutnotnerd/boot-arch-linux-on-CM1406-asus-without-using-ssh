[Unit]
Description=Bind the Elan touchpad to hid-multitouch
After=systemd-modules-load.service systemd-udev-settle.service
Before=tarkin-console.service display-manager.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/libexec/tarkin/touchpad-bind

[Install]
WantedBy=multi-user.target
