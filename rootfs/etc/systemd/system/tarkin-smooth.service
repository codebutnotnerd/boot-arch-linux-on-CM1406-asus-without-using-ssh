[Unit]
Description=Tarkin smooth mode (GPU minimum 526 MHz, Hyprland on the fast cores)
After=tarkin-console.service

[Service]
Type=simple
ExecStart=/usr/local/libexec/tarkin/smooth run
ExecStopPost=/usr/local/libexec/tarkin/smooth stop
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
