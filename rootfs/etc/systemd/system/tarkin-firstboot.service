[Unit]
Description=Tarkin first boot: Hyprland, Mali GPU stack and sound for alarm (runs once)
ConditionPathExists=/var/lib/tarkin/firstboot.pending
After=network.target systemd-networkd.service systemd-resolved.service wpa_supplicant@wlan0.service systemd-user-sessions.service

[Service]
Type=simple
ExecStart=/usr/local/libexec/tarkin/firstboot
ExecStopPost=/usr/bin/rm -f /etc/sudoers.d/99-tarkin-firstboot
TimeoutStopSec=90
KillMode=control-group

[Install]
WantedBy=multi-user.target
