[Unit]
Description=Built-in sound of the CM1406: routes, default sink, volume, headphone jack switching
After=wireplumber.service pipewire-pulse.service
Wants=wireplumber.service pipewire-pulse.service

[Service]
Type=simple
ExecStart=/usr/local/libexec/tarkin/audio-profile
ExecStop=/usr/local/libexec/tarkin/audio-profile save
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
