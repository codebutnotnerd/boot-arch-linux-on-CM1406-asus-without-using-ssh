#!/bin/bash
# ASUS CM14 (CM1406CM4A): Omarchy reads the lid from /proc/acpi/button/lid, which an ARM64 Chromebook doesn't have.
# The ChromeOS EC reports the lid as SW_LID on cros_ec_buttons.
# Shadows /usr/bin/omarchy-hw-laptop-closed through PATH (/usr/local/bin first). Exit 0 = closed.
for d in /sys/class/input/event*; do
  caps=$(<"$d/device/capabilities/sw") 2>/dev/null || continue
  (( 0x${caps##* } & 1 )) || continue
  if command -v evtest >/dev/null 2>&1; then
    evtest --query "/dev/input/${d##*/}" EV_SW SW_LID 2>/dev/null
    [[ $? == 10 ]] && exit 0
  else
    # Python fallback using evdev
    python3 -c "import evdev, sys; d=evdev.InputDevice('/dev/input/${d##*/}'); sys.exit(0 if d.active_keys(verbose=False) and evdev.ecodes.SW_LID in d.active_keys(verbose=False) else 1)" 2>/dev/null && exit 0
  fi
done
exec /usr/bin/omarchy-hw-laptop-closed
