#!/bin/bash
# ==============================================================================
# asus-cm14-init - First-boot provisioner for ASUS Chromebook CM14 (Omarchy)
# ==============================================================================
set -euo pipefail

DONE_FILE=/var/lib/asus-cm14/first-boot.done
if [[ -f "$DONE_FILE" ]]; then
  exit 0
fi

exec > >(tee -a /var/log/asus-cm14-first-boot.log) 2>&1

if [[ "$EUID" -ne 0 ]]; then
  echo "[-] Run this first-boot script as root." >&2
  exit 1
fi

echo "=== ASUS CM14 First-Boot Initialization ==="

# Critical: establish the base system identity and verify the installed root.
printf '%s\n' asus-cm14 > /etc/hostname
hostname asus-cm14
if [[ ! -s /etc/fstab ]] \
  || ! grep -Eq '^[[:space:]]*PARTUUID=[^[:space:]]+[[:space:]]+/[[:space:]]' /etc/fstab; then
  echo "[-] /etc/fstab has no PARTUUID root entry; refusing to mark first boot complete." >&2
  exit 1
fi

# Critical: create the account and all required local groups.
for group in wheel video input audio seat render storage; do
  if ! getent group "$group" >/dev/null; then
    groupadd "$group"
  fi
done
if id alarm >/dev/null 2>&1; then
  usermod -aG wheel,video,input,audio,seat,render,storage alarm
else
  useradd -m -G wheel,video,input,audio,seat,render,storage -s /bin/bash alarm
fi
echo "alarm:alarm" | chpasswd
chage -d 0 alarm

root_hash="$(awk -F: '$1 == "root" { print $2; exit }' /etc/shadow)"
case "$root_hash" in
  ''|'!'|'!!'|'*'|!*)
    echo "root:root" | chpasswd
    chage -d 0 root
    ;;
esac

install -d -m 755 /etc/sudoers.d
printf '%%wheel ALL=(ALL:ALL) ALL\n' > /etc/sudoers.d/10-wheel
chmod 440 /etc/sudoers.d/10-wheel

printf '%s\n' 'Login: alarm / Mot de passe: alarm' > /etc/issue
systemctl enable getty@tty1.service

# Prevent a failed optional desktop step from replaying initialization at every boot.
systemctl disable asus-cm14-first-boot.service \
  || echo "[warn] Could not disable asus-cm14-first-boot.service."
install -d -m 755 "$(dirname "$DONE_FILE")"
touch "$DONE_FILE"

if [[ -d /etc/skel/.config/hypr ]]; then
  install -d -o alarm -g alarm /home/alarm/.config/hypr \
    || echo "[warn] Could not create /home/alarm/.config/hypr."
  cp -an /etc/skel/.config/hypr/. /home/alarm/.config/hypr/ \
    || echo "[warn] Could not copy the Hyprland skeleton configuration."
  chown -R alarm:alarm /home/alarm/.config \
    || echo "[warn] Could not set ownership on /home/alarm/.config."
else
  echo "[warn] No Hyprland configuration found in /etc/skel."
fi

if [[ ! -s /etc/machine-id ]]; then
  systemd-machine-id-setup || echo "[warn] Could not initialize /etc/machine-id."
fi

if systemctl list-unit-files seatd.service --no-legend | grep -q seatd.service; then
  systemctl enable --now seatd.service \
    || echo "[warn] Could not enable seatd.service."
else
  echo "[warn] seatd.service is not installed."
fi

if [[ -d /usr/share/omarchy && -f /usr/local/share/quigon/setup-omarchy.sh ]]; then
  echo "== Finalizing Omarchy desktop setup for user alarm..."
  DESKTOP_USER=alarm bash /usr/local/share/quigon/setup-omarchy.sh \
    || echo "[warn] Omarchy ARM64 package setup failed; see its log output."
fi

echo "=== First-boot initialization complete! ==="
