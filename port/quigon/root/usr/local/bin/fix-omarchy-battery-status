#!/bin/bash
# Make omarchy-battery-status (the bar's power panel) find non-x86 batteries on the ASUS Chromebook CM14 (CM1406CM4A).
# Stock matches only "BAT" (BAT0 on x86), so on this ARM64 Chromebook (UPower .../battery_sbs_10_000b,
# smart-battery "sbs-10-000b", or cros_ec battery) the panel shows no %, W, Wh, or remaining time.
# Also reads cycles/thresholds from the found battery instead of BAT*, and takes |power| (sbs reports current_now
# negative while discharging and has no power_now).
# Idempotent; re-applied by zz-omarchy-battery-status.hook after omarchy upgrades.
f=/usr/bin/omarchy-battery-status
[[ -f $f ]] || exit 0
sed -i \
  -e "s/grep BAT | head -n 1/grep -E 'BAT|_bat\$|\/battery_|^sbs|^cros' | head -n 1/" \
  -e 's|"\$power_supply_path"/BAT\*/|"$battery_path"/|g' \
  -e 's|BEGIN { print microwatts / 1000000 }|BEGIN { w = microwatts / 1000000; print (w < 0 ? -w : w) }|' \
  -e 's|BEGIN { print microamps \* microvolts / 1000000000000 }|BEGIN { w = microamps * microvolts / 1000000000000; print (w < 0 ? -w : w) }|' \
  "$f"
