CONFIG_TOUCHSCREEN_GOODIX=y

# Audio (MT8186 & MT8189: Combo Jack RT5682S/DA7219/NAU8825, Speakers RT1019P/RT1015P/MAX98357A)
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_MEDIATEK=y
CONFIG_SND_SOC_MT8186=y
CONFIG_SND_SOC_MT8186_MT6366=y
CONFIG_SND_SOC_MT8189=y
CONFIG_SND_SOC_MT8189_NAU8825=y
CONFIG_SND_SOC_RT5682S=y
CONFIG_SND_SOC_RT1019P=y
CONFIG_SND_SOC_RT1015P=y
CONFIG_SND_SOC_DA7219=y
CONFIG_SND_SOC_MAX98357A=y
CONFIG_SND_SOC_DMIC=y

# Thermal and Sensors (MT8186 & MT8189 LVTS)
CONFIG_THERMAL=y
CONFIG_THERMAL_OF=y
CONFIG_MTK_THERMAL=y
CONFIG_MTK_SOC_THERMAL=y
CONFIG_MTK_LVTS_THERMAL=y

# USB & Camera (UVC)
