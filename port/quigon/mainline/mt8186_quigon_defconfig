# ASUS Chromebook CM14 (CM1406CM4A - MT8186/MT8189 Corsola Quigon & Obiwan) Linux Defconfig
# Base: ARM64 defconfig trimmed and tuned for MediaTek Kompanio 520/540
CONFIG_ARM64=y
CONFIG_ARCH_MEDIATEK=y
CONFIG_64BIT=y
CONFIG_ARM64_VA_BITS_48=y
CONFIG_CMDLINE_FORCE=n

# General setup
CONFIG_INIT_ENV_ARG_LIMIT=32
CONFIG_COMPILE_TEST=n
CONFIG_LOCALVERSION="-quigon-mt8186"
CONFIG_POSIX_MQUEUE=y
CONFIG_AUDIT=y
CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_PREEMPT_VOLUNTARY=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_LOG_BUF_SHIFT=17
CONFIG_LOG_CPU_MAX_BUF_SHIFT=12
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_CGROUP_SCHED=y
CONFIG_UCLAMP_TASK=y
CONFIG_UCLAMP_TASK_GROUP=y
CONFIG_NAMESPACES=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_INITRAMFS_SOURCE=""
CONFIG_RD_GZIP=y
CONFIG_RD_XZ=y
CONFIG_RD_LZ4=y
CONFIG_RD_ZSTD=y
CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=y

# Coreboot / Depthcharge firmware support
CONFIG_COREBOOT_TABLE=y
CONFIG_COREBOOT_FRAMEBUFFER=y
CONFIG_COREBOOT_MEMCONSOLE=y
CONFIG_COREBOOT_MEMCONSOLE_COREBOOT=y

# CPU and Power Management
CONFIG_ARM_MEDIATEK_CPUFREQ_HW=y
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
CONFIG_CPU_FREQ_GOV_USERSPACE=y
CONFIG_CPU_FREQ_GOV_ONDEMAND=y
CONFIG_CPU_IDLE=y
CONFIG_ARM_CPUIDLE=y
CONFIG_PM_AUTOSLEEP=y
CONFIG_PM_WAKELOCKS=y
CONFIG_PM_DEBUG=y
CONFIG_PM_ADVANCED_DEBUG=y

# MediaTek SoC Clocks, Pinctrl & Power Domains (MT8186 & MT8189)
CONFIG_COMMON_CLK_MT8186=y
CONFIG_COMMON_CLK_MT8186_MCUCFG=y
CONFIG_COMMON_CLK_MT8186_MMSYS=y
CONFIG_COMMON_CLK_MT8186_WPE=y
CONFIG_PINCTRL_MT8186=y
CONFIG_COMMON_CLK_MT8189=y
CONFIG_COMMON_CLK_MT8189_BUS=y
CONFIG_COMMON_CLK_MT8189_DBGAO=y
CONFIG_COMMON_CLK_MT8189_DVFSRC=y
CONFIG_COMMON_CLK_MT8189_IIC=y
CONFIG_COMMON_CLK_MT8189_MFG=y
CONFIG_COMMON_CLK_MT8189_MMSYS=y
CONFIG_COMMON_CLK_MT8189_SCP=y
CONFIG_COMMON_CLK_MT8189_UFS=y
CONFIG_COMMON_CLK_MT8189_VCODEC=y
CONFIG_PINCTRL_MT8189=y
CONFIG_MTK_SCPSYS=y
CONFIG_MTK_SCPSYS_PM_DOMAINS=y
CONFIG_MTK_CMDQ=y
CONFIG_MTK_MMSYS=y
CONFIG_MEDIATEK_WATCHDOG=y
CONFIG_SERIAL_8250_MT6577=y

# Storage: 128 GB eMMC 5.1 (MSDC0), SD Card (MSDC1) & UFS (MT8189)
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_BLOCK_MINORS=16
CONFIG_MMC_MTK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_MTK=y
CONFIG_MMC_CQHCI=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_SCSI_UFS_MEDIATEK=y

# PCIe & PHYs (Wi-Fi 7 MT7925, T-PHY, XS-PHY)
CONFIG_PCI=y
CONFIG_PCIEPORTBUS=y
CONFIG_PCIE_MEDIATEK_GEN3=y
CONFIG_PHY_MTK_TPHY=y
CONFIG_PHY_MTK_XSPHY=y

# Display, DRM, KMS, Framebuffer Console (Avoid Black Screen)
CONFIG_DRM=y
CONFIG_DRM_KMS_HELPER=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_FBDEV_OVERALLOC=100
CONFIG_FB=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
CONFIG_FRAMEBUFFER_CONSOLE_ROTATION=y
CONFIG_FONTS=y
CONFIG_FONT_8x16=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_MEDIATEK=y
CONFIG_DRM_MEDIATEK_DP=y
CONFIG_DRM_MEDIATEK_DP_V2=y
CONFIG_DRM_MEDIATEK_DSI=y
CONFIG_DRM_ANALOGIX_ANX7625=y
CONFIG_DRM_ITE_IT61620=y
CONFIG_DRM_PANEL_EDP=y
CONFIG_DRM_PANEL_SIMPLE=y
CONFIG_DRM_DISPLAY_DP_AUX_BUS=y
CONFIG_PHY_MTK_EDP=y
CONFIG_PHY_MTK_MIPI_DSI=y
